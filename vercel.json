{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/favicon.svg" },
    { "source": "/demo/:slug/:path*", "destination": "/demos/:slug/:path*" },
    { "source": "/work/:path*", "destination": "/index.html" }
  ]
}
